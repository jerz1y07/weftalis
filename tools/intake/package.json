{
  "name": "weftalis-intake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local, review-first intake for upstream workflow artifacts",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "intake": "node --import tsx src/cli.ts",
    "validate-schemas": "node --import tsx src/schema-cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
